					"items": [
						{
							"type": "item",
							"name": "Adept Climber",
							"entries": [
								"You gain a {@variantrule climbing speed} equal to your walking speed and proficiency in the {@skill Athletics} or {@skill Acrobatics} skill (your choice)."
							]
						},
						{
							"type": "item",
							"name": "High Flyer",
							"entries": [
								"You have a {@variantrule fly speed} equal to your walking speed. You can't use this fly speed if you're wearing medium or heavy armor. Additionally, you cannot cast spells with a verbal component while flying in this way."
							]
						},
						{
							"type": "item",
							"name": "Natural Weapon",
							"entries": [
								"You have a natural weapon, such as claws, teeth, or horns. Your unarmed strikes deal {@dice 1d4} damage on a hit. When you gain this trait, choose the damage type: bludgeoning, piercing, poison, or slashing. You can use Dexterity instead of Strength for the attack and damage rolls of this unarmed strike."
							]
						},
						{
							"type": "item",
							"name": "Swift Strider",
							"entries": [
